{
  "name": "@bustrack/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/*.ts",
    "./models": "./src/models/index.ts",
    "./models/*": "./src/models/*.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}

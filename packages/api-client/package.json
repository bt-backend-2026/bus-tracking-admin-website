{
  "name": "@bustrack/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./services/*": "./src/services/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bustrack/types": "*",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.18.1",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/sockjs-client": "^1.5.4",
    "typescript": "^5"
  }
}

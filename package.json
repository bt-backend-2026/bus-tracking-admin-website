{
  "name": "bus-tracking-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "dev:admin": "turbo run dev --filter=@bustrack/admin",
    "dev:superadmin": "turbo run dev --filter=@bustrack/superadmin"
  },
  "devDependencies": {
    "turbo": "^2.6.0"
  }
}